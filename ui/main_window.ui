  <property name="styleSheet">
   <string notr="true">
QMainWindow {
    background-color: #F2F2F7;
}

/* === SIDEBAR === */
#sidebar {
    background-color: #FFFFFF;
    border-right: 1px solid #E5E5EA;
    min-width: 220px;
    max-width: 220px;
}

#appTitle {
    font-family: -apple-system, "SF Pro Display", "Helvetica Neue", sans-serif;
    font-size: 17px;
    font-weight: 600;
    color: #1C1C1E;
    padding: 0px 20px;
    margin: 0;
}

#appSubtitle {
    font-family: -apple-system, "SF Pro Text", "Helvetica Neue", sans-serif;
    font-size: 12px;
    color: #8E8E93;
    padding: 0px 20px;
    margin: 0;
}

#sectionLabel {
    font-family: -apple-system, "SF Pro Text", "Helvetica Neue", sans-serif;
    font-size: 11px;
    font-weight: 600;
    color: #8E8E93;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    padding: 6px 20px 4px 20px;
}

QPushButton#navBtn {
    background-color: transparent;
    border: none;
    border-radius: 10px;
    text-align: left;
    padding: 9px 14px;
    font-family: -apple-system, "SF Pro Text", "Helvetica Neue", sans-serif;
    font-size: 14px;
    color: #1C1C1E;
    margin: 1px 10px;
}

QPushButton#navBtn:hover {
    background-color: #F2F2F7;
}

QPushButton#navBtn:checked {
    background-color: #007AFF;
    color: #FFFFFF;
}

/* === CONTENT === */
#contentArea {
    background-color: #F2F2F7;
}

#pageTitle {
    font-family: -apple-system, "SF Pro Display", "Helvetica Neue", sans-serif;
    font-size: 28px;
    font-weight: 700;
    color: #1C1C1E;
    margin: 0;
}

/* === TOOLBAR === */
#searchBox {
    background-color: #FFFFFF;
    border: 1px solid #E5E5EA;
    border-radius: 10px;
    padding: 7px 14px;
    font-family: -apple-system, "SF Pro Text", "Helvetica Neue", sans-serif;
    font-size: 14px;
    color: #1C1C1E;
    min-width: 240px;
}

#searchBox:focus {
    border-color: #007AFF;
    outline: none;
}

#searchBox::placeholder {
    color: #C7C7CC;
}

QPushButton#primaryBtn {
    background-color: #007AFF;
    color: #FFFFFF;
    border: none;
    border-radius: 10px;
    padding: 8px 18px;
    font-family: -apple-system, "SF Pro Text", "Helvetica Neue", sans-serif;
    font-size: 14px;
    font-weight: 500;
}

QPushButton#primaryBtn:hover {
    background-color: #0066CC;
}

QPushButton#primaryBtn:pressed {
    background-color: #0055AA;
}

QPushButton#dangerBtn {
    background-color: transparent;
    color: #FF3B30;
    border: 1px solid #FF3B30;
    border-radius: 10px;
    padding: 8px 18px;
    font-family: -apple-system, "SF Pro Text", "Helvetica Neue", sans-serif;
    font-size: 14px;
    font-weight: 500;
}

QPushButton#dangerBtn:hover {
    background-color: #FFF0EF;
}

QPushButton#secondaryBtn {
    background-color: transparent;
    color: #007AFF;
    border: 1px solid #007AFF;
    border-radius: 10px;
    padding: 8px 18px;
    font-family: -apple-system, "SF Pro Text", "Helvetica Neue", sans-serif;
    font-size: 14px;
    font-weight: 500;
}

QPushButton#secondaryBtn:hover {
    background-color: #F0F7FF;
}

/* === TABLE === */
QTableWidget {
    background-color: #FFFFFF;
    border: none;
    border-radius: 12px;
    gridline-color: #F2F2F7;
    font-family: -apple-system, "SF Pro Text", "Helvetica Neue", sans-serif;
    font-size: 13px;
    color: #1C1C1E;
    selection-background-color: #EAF3FF;
    selection-color: #1C1C1E;
}

QTableWidget::item {
    padding: 10px 16px;
    border-bottom: 1px solid #F2F2F7;
}

QTableWidget::item:selected {
    background-color: #EAF3FF;
    color: #1C1C1E;
}

QHeaderView::section {
    background-color: #F9F9FB;
    border: none;
    border-bottom: 1px solid #E5E5EA;
    padding: 10px 16px;
    font-family: -apple-system, "SF Pro Text", "Helvetica Neue", sans-serif;
    font-size: 12px;
    font-weight: 600;
    color: #8E8E93;
    letter-spacing: 0.3px;
}

QScrollBar:vertical {
    background: transparent;
    width: 6px;
}

QScrollBar::handle:vertical {
    background: #C7C7CC;
    border-radius: 3px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* === STAT CARDS === */
#statCard {
    background-color: #FFFFFF;
    border-radius: 12px;
    padding: 16px;
}

#statValue {
    font-family: -apple-system, "SF Pro Display", "Helvetica Neue", sans-serif;
    font-size: 32px;
    font-weight: 700;
    color: #1C1C1E;
}

#statLabel {
    font-family: -apple-system, "SF Pro Text", "Helvetica Neue", sans-serif;
    font-size: 12px;
    color: #8E8E93;
}

/* === FILTER COMBO === */
QComboBox#filterCombo {
    background-color: #FFFFFF;
    border: 1px solid #E5E5EA;
    border-radius: 10px;
    padding: 7px 14px;
    font-family: -apple-system, "SF Pro Text", "Helvetica Neue", sans-serif;
    font-size: 14px;
    color: #1C1C1E;
    min-width: 160px;
}

QComboBox#filterCombo:focus {
    border-color: #007AFF;
}

QComboBox#filterCombo::drop-down {
    border: none;
    width: 24px;
}

QComboBox#filterCombo::down-arrow {
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #E5E5EA;
    border-radius: 10px;
    selection-background-color: #EAF3FF;
    selection-color: #1C1C1E;
    font-family: -apple-system, "SF Pro Text", "Helvetica Neue", sans-serif;
    font-size: 14px;
    padding: 4px;
}

/* === STATUS BAR === */
QStatusBar {
    background-color: #FFFFFF;
    border-top: 1px solid #E5E5EA;
    font-family: -apple-system, "SF Pro Text", "Helvetica Neue", sans-serif;
    font-size: 12px;
    color: #8E8E93;
}
